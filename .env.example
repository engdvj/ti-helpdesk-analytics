# GLPI (rede interna do hospital — nunca commitar valores reais)
GLPI_URL=http://10.17.38.243
GLPI_API_PATH=/api.php/v1
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# Backend
DATABASE_URL=postgresql+psycopg2://ti_analytics:ti_analytics@localhost:5432/ti_analytics
# Pra acessar de outro PC na rede (docker-compose.yml), troque localhost pelo
# IP da maquina que roda o docker compose (ex.: 10.17.200.7) nas duas
# variaveis abaixo - CORS_ORIGINS precisa bater com a origem que o navegador
# manda, e NEXT_PUBLIC_API_URL fica gravado no bundle do frontend em build
# time (mudar depois exige `docker compose build web` de novo).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Trava do painel /admin (coleta manual, editar pesos de score) - nao e conta
# de usuario de verdade, so credencial compartilhada. Sem essas vars, /admin fica 500.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
